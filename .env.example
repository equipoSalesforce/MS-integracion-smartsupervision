# ======================================================================
# CONFIGURACIÓN GENERAL DEL MICROSERVICIO
# ======================================================================
ENVIRONMENT=local
PROJECT_NAME="MS-integracion-smartsupervision"
API_V1_STR="/api/v1"

# ======================================================================
# ☁️ CONFIGURACIÓN DE AWS S3
# ======================================================================
AWS_S3_BUCKET="mi-bucket-smartsupervision"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_ENDPOINT_URL="http://minio:9000"
AWS_REGION="us-east-1"

# ======================================================================
# 🇨🇴 CONSTANTES DE ENTIDAD PARA GLOBAL66 (SFC)
# ======================================================================
SFC_TIPO_ENTIDAD=128
SFC_ENTIDAD_COD=6

# ======================================================================
# 🛡️ INTEGRACIÓN CON SMART SUPERVISIÓN (SFC)
# ======================================================================
SFC_URL_BASE="http://127.0.0.1:8080/"

# Credenciales y Secret Key suministrados por la SFC (o valores de test para el Mock)
SFC_USERNAME="admin"
SFC_PASSWORD="123456789"
SFC_SECRET_KEY="global66_sfc_secret_key_testing_2026"

CRM_API_KEY="g66_sk_test_super_secreto_12345"
ADMIN_API_KEY="g66_sk_test_admin_secreto_99999"
# Asegúrate de usar comillas dobles dentro del arreglo (formato JSON válido)
CRM_CORS_ORIGINS='["https://tucrm.global66.com", "http://localhost:8000", "http://localhost:3000"]'

QUEUE_RETRY_INTERVAL_MINUTES = 5
QUEUE_MAX_RETRIES = 10
QUEUE_RETENTION_DAYS = 7
QUEUE_RETENTION_DAYS_DLQ = 30

# Límites de paginación M1/M4 (corta y alerta si se exceden)
SFC_SYNC_MAX_PAGINAS = 1000
SFC_SYNC_MAX_SEGUNDOS = 300

# -- Configuración de SMTP para alerta por correo -- #
SMTP_USER = "tucorreo@global66.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
# Opcional: dirección "From" visible. Si se omite, usa SMTP_USER (válido en Gmail).
# En AWS SES, SMTP_USER es una credencial IAM generada (no un correo entregable):
# definir SMTP_FROM_EMAIL explícitamente con una identidad verificada en SES.
SMTP_FROM_EMAIL = "alertas@global66.com"

ALERT_NOTIFY_EMAILS = ["tucorreo@global66.com", "tucorreo@global66.com"]
ALERT_EMAILS_ENABLED = false

# -- Enlace del sheet con la matriz de errores -- #
GOOGLE_CLIENT_ID="id_cliente"
GOOGLE_CLIENT_SECRET="secret_cliente"
GOOGLE_REFRESH_TOKEN="refresh_token"
GOOGLE_SPREADSHEET_ID="id_hoja"
GOOGLE_SHEET_RANGE="Hoja 1!A:C"  # Nombre de la pestaña y columnas
GOOGLE_CATALOGS_SPREADSHEET_ID="tu_id_del_nuevo_sheet_aqui"

# -- Conexión con Redis y cola centralizada -- #
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_SSL=false
# REDIS_URL="redis://:password@localhost:6379/0"

# ======================================================================
# 🔔 WEBHOOK DE CONFIRMACIÓN HACIA EL CRM
# ======================================================================
CRM_WEBHOOK_URL="https://tu-crm.global66.com/api/v1/cases/status-callback"
CRM_WEBHOOK_API_KEY="crm_secret_webhook_key_2026"