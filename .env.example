# ======================================================================
# CONFIGURACIÓN GENERAL DEL MICROSERVICIO
# ======================================================================
ENVIRONMENT=local
PROJECT_NAME="MS-integracion-smartsupervision"
API_V1_STR="/api/v1"

# Interruptor de seguridad para /docs, /redoc y /openapi.json (debe quedar en
# False fuera de 'local' -- ver validación estricta en app/core/config.py).
ENABLE_DOCS=false
ENABLE_FILE_LOGS=false
# Tamaño máximo (bytes) del body de una request HTTP entrante.
MAX_REQUEST_BODY_SIZE_BYTES=2097152

# Rate limit por API key para los endpoints que consume el CRM.
CRM_RATE_LIMIT_ENABLED=true
CRM_RATE_LIMIT_MAX_REQUESTS=120
CRM_RATE_LIMIT_WINDOW_SECONDS=60

RUN_SCHEDULER=false

# ======================================================================
# ☁️ CONFIGURACIÓN DE AWS S3
# ======================================================================
AWS_S3_BUCKET="mi-bucket-smartsupervision"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_ENDPOINT_URL="http://minio:9000"
AWS_REGION="us-east-1"
# Opcionales, normalmente sin usar fuera de un rol IAM con credenciales
# temporales (AWS_SESSION_TOKEN) o de un endpoint S3 alterno al de MinIO/AWS
# (AWS_S3_ENDPOINT_URL).
# AWS_SESSION_TOKEN=""
# AWS_S3_ENDPOINT_URL=""

# ======================================================================
# 🇨🇴 CONSTANTES DE ENTIDAD PARA GLOBAL66 (SFC)
# ======================================================================
SFC_TIPO_ENTIDAD=128
SFC_ENTIDAD_COD=6

# ======================================================================
# 🛡️ INTEGRACIÓN CON SMART SUPERVISIÓN (SFC)
# ======================================================================
SFC_URL_BASE="http://127.0.0.1:8080/"

# Credenciales y Secret Key suministrados por la SFC (o valores de test para el Mock)
# 🔒 Los valores de este bloque son placeholders de ejemplo -- reemplázalos con las
# credenciales reales entregadas por la SFC/CRM en tu .env local (nunca comitear ese .env).
SFC_USERNAME="<sfc-username>"
SFC_PASSWORD="<sfc-password>"
SFC_SECRET_KEY="<sfc-secret-key>"

CRM_API_KEY="<crm-api-key>"
ADMIN_API_KEY="<admin-api-key>"
# Asegúrate de usar comillas dobles dentro del arreglo (formato JSON válido)
CRM_CORS_ORIGINS='["https://tucrm.global66.com", "http://localhost:8000", "http://localhost:3000"]'

QUEUE_ENABLED = true
QUEUE_RETRY_INTERVAL_MINUTES = 5
QUEUE_MAX_RETRIES = 10
QUEUE_RETENTION_DAYS = 7
QUEUE_RETENTION_DAYS_DLQ = 30

# Límites de paginación M1/M4 (corta y alerta si se exceden)
SFC_SYNC_MAX_PAGINAS = 1000
SFC_SYNC_MAX_SEGUNDOS = 300

# Reintentos cortos ("mini-retry") ante un timeout/429 puntual de la SFC, antes
# de encolar el caso para reintento vía Redis.
SFC_MINI_RETRY_ATTEMPTS = 2
SFC_MINI_RETRY_DELAY_SECONDS = 5.5

# -- Configuración de SMTP para alerta por correo -- #
# Estos valores por defecto son de Gmail; en AWS no se asume SES -- cada
# ambiente declara su propio SMTP_HOST/SMTP_PORT (ej. email-smtp.<region>.amazonaws.com:587
# para SES, o cualquier otro proveedor).
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "tucorreo@global66.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
# Opcional: dirección "From" visible. Si se omite, usa SMTP_USER (válido en Gmail).
# En AWS SES, SMTP_USER es una credencial IAM generada (no un correo entregable):
# definir SMTP_FROM_EMAIL explícitamente con una identidad verificada en SES.
SMTP_FROM_EMAIL = "alertas@global66.com"

ALERT_NOTIFY_EMAILS = ["tucorreo@global66.com", "tucorreo@global66.com"]
ALERT_EMAILS_ENABLED = false

# -- Enlace del sheet con la matriz de errores -- #
GOOGLE_CLIENT_ID="<google-client-id>"
GOOGLE_CLIENT_SECRET="<google-client-secret>"
GOOGLE_REFRESH_TOKEN="<google-refresh-token>"
GOOGLE_SPREADSHEET_ID="id_hoja"
GOOGLE_SHEET_RANGE="Hoja 1!A:C"  # Nombre de la pestaña y columnas
GOOGLE_CATALOGS_SPREADSHEET_ID="tu_id_del_nuevo_sheet_aqui"

# -- Conexión con Redis y cola centralizada -- #
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_SSL=false
# Activa el modo Redis Cluster (AWS ElastiCache Cluster). False para un Redis
# standalone como el de docker-compose.yml.
REDIS_CLUSTER_MODE=false
# REDIS_URL="redis://:password@localhost:6379/0"

# ======================================================================
# 🔔 WEBHOOK DE CONFIRMACIÓN HACIA EL CRM
# ======================================================================
CRM_WEBHOOK_URL="https://tu-crm.global66.com/api/v1/cases/status-callback"
# Opcional: sólo declarar en true si CRM_WEBHOOK_URL es un endpoint interno de
# confianza (misma VPC/cuenta AWS). En ci/dev/qa/prod, http:// se rechaza por
# defecto -- este flag es la única forma de permitirlo explícitamente.
CRM_WEBHOOK_ALLOW_INSECURE_HTTP=false
CRM_WEBHOOK_API_KEY="<crm-webhook-api-key>"